{
  "name": "founder-product-compiler",
  "version": "0.1.0",
  "description": "Compile founder product intent into deterministic, readiness-gated build contracts.",
  "license": "Apache-2.0",
  "author": {
    "name": "plugtheliam"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/plugtheliam/founder-product-compiler.git"
  },
  "homepage": "https://github.com/plugtheliam/founder-product-compiler",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:compiler && npm run test:docs",
    "test:compiler": "tsx --test test/fpc.test.ts",
    "test:docs": "node --test test/readme.test.mjs test/community-files.test.mjs",
    "test:public": "node --test test/public-release.test.mjs",
    "test:determinism": "node --test --test-name-pattern=deterministic --import tsx test/fpc.test.ts",
    "validate:schemas": "tsx scripts/validate-artifacts.ts",
    "build:plugin": "npm run build && node scripts/build-plugin.mjs",
    "validate:public": "node scripts/public-validate.mjs",
    "check:plugin": "npm run build:plugin -- --check",
    "check:release": "npm ci && npm run typecheck && npm test && npm run build && npm run build:plugin && npm run validate:public && npm run check:plugin && npm run test:public"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
