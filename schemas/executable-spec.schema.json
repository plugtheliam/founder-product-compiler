{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://founder-product-compiler.local/schemas/executable-spec.v0.json",
  "title": "Founder Product Compiler Executable Spec v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "compilerVersion", "productId", "productIRHash", "promise", "magicMoment", "coreLoop", "wedge", "journeys", "goals", "authorityMatrix", "autonomyBudget", "oracles", "forbiddenScope"],
  "properties": {
    "schemaVersion": { "const": "fpc.v0" },
    "compilerVersion": { "$ref": "#/$defs/nonEmpty" },
    "productId": { "$ref": "#/$defs/nonEmpty" },
    "productIRHash": { "$ref": "#/$defs/hash" },
    "promise": { "$ref": "#/$defs/nonEmpty" },
    "magicMoment": { "$ref": "#/$defs/magicMoment" },
    "coreLoop": { "$ref": "#/$defs/coreLoop" },
    "wedge": { "$ref": "#/$defs/wedge" },
    "journeys": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/journey" } },
    "goals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/goal" } },
    "authorityMatrix": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/authority" } },
    "autonomyBudget": { "$ref": "#/$defs/autonomyBudget" },
    "oracles": { "$ref": "#/$defs/oracles" },
    "forbiddenScope": { "$ref": "#/$defs/nonEmptyList" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stringList": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
    "nonEmptyList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
    "magicMoment": {
      "type": "object", "additionalProperties": false, "required": ["id", "definition"],
      "properties": { "id": { "$ref": "#/$defs/nonEmpty" }, "definition": { "$ref": "#/$defs/nonEmpty" } }
    },
    "coreLoop": {
      "type": "object", "additionalProperties": false, "required": ["id", "steps"],
      "properties": { "id": { "$ref": "#/$defs/nonEmpty" }, "steps": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/nonEmpty" } } }
    },
    "wedge": {
      "type": "object", "additionalProperties": false, "required": ["id", "definition"],
      "properties": { "id": { "$ref": "#/$defs/nonEmpty" }, "definition": { "$ref": "#/$defs/nonEmpty" } }
    },
    "journey": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "stage", "userAction", "productResponse", "observableOracle"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" }, "stage": { "$ref": "#/$defs/nonEmpty" },
        "userAction": { "$ref": "#/$defs/nonEmpty" }, "productResponse": { "$ref": "#/$defs/nonEmpty" },
        "observableOracle": { "$ref": "#/$defs/nonEmpty" }, "magicMomentRef": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false, "required": ["owner"],
      "properties": {
        "owner": { "$ref": "#/$defs/nonEmpty" }, "constraint": { "$ref": "#/$defs/nonEmpty" },
        "escalationWhen": { "$ref": "#/$defs/nonEmpty" }, "examples": { "$ref": "#/$defs/nonEmptyList" }
      }
    },
    "autonomyBudget": {
      "type": "object", "additionalProperties": false,
      "required": ["maxReviewCycles", "maxBlockerDepth", "maxNoProgressCycles", "maxGoalExpansionRatio", "maxParallelWorkers", "wallClockLimitMinutes", "quotaLimitPercent"],
      "properties": {
        "maxReviewCycles": { "type": "integer", "minimum": 1, "maximum": 10 },
        "maxBlockerDepth": { "type": "integer", "minimum": 1, "maximum": 10 },
        "maxNoProgressCycles": { "type": "integer", "minimum": 1, "maximum": 10 },
        "maxGoalExpansionRatio": { "type": "number", "minimum": 1, "maximum": 10 },
        "maxParallelWorkers": { "type": "integer", "minimum": 1, "maximum": 32 },
        "wallClockLimitMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "quotaLimitPercent": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
      }
    },
    "oracle": {
      "type": "object", "additionalProperties": false, "required": ["id", "description"],
      "properties": { "id": { "$ref": "#/$defs/nonEmpty" }, "description": { "$ref": "#/$defs/nonEmpty" } }
    },
    "oracles": {
      "type": "object", "additionalProperties": false, "required": ["code", "journey", "thesis"],
      "properties": {
        "code": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/oracle" } },
        "journey": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/oracle" } },
        "thesis": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/oracle" } }
      }
    },
    "oracleRefs": {
      "type": "object", "additionalProperties": false, "required": ["code", "journey", "thesis"],
      "properties": {
        "code": { "$ref": "#/$defs/nonEmptyList" }, "journey": { "$ref": "#/$defs/nonEmptyList" }, "thesis": { "$ref": "#/$defs/nonEmptyList" }
      }
    },
    "validationBoundary": {
      "type": "object", "additionalProperties": false, "required": ["code", "journey", "thesis"],
      "properties": {
        "code": { "$ref": "#/$defs/nonEmptyList" }, "journey": { "$ref": "#/$defs/nonEmptyList" }, "thesis": { "$ref": "#/$defs/nonEmptyList" }
      }
    },
    "verticalSlice": {
      "type": "object", "additionalProperties": false, "required": ["stages", "deliversMagicMoment"],
      "properties": { "stages": { "$ref": "#/$defs/nonEmptyList" }, "deliversMagicMoment": { "type": "boolean" } }
    },
    "goal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "charterRefs", "journeyRefs", "localObjective", "localAcceptance", "globalAcceptance", "forbiddenScope", "escalationRule", "dependencies", "validationBoundary", "oracleRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" }, "title": { "$ref": "#/$defs/nonEmpty" },
        "charterRefs": { "$ref": "#/$defs/nonEmptyList" }, "journeyRefs": { "$ref": "#/$defs/stringList" },
        "localObjective": { "$ref": "#/$defs/nonEmpty" }, "localAcceptance": { "$ref": "#/$defs/nonEmptyList" },
        "globalAcceptance": { "$ref": "#/$defs/stringList" }, "forbiddenScope": { "$ref": "#/$defs/nonEmptyList" },
        "escalationRule": { "$ref": "#/$defs/nonEmpty" }, "dependencies": { "$ref": "#/$defs/stringList" },
        "validationBoundary": { "$ref": "#/$defs/validationBoundary" }, "oracleRefs": { "$ref": "#/$defs/oracleRefs" },
        "verticalSlice": { "$ref": "#/$defs/verticalSlice" }
      }
    }
  }
}
